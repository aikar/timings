#!/bin/bash

# Aikar timings deploy script
#
# Deploys the current state of this dev checkout to ../production. No git network access is needed
# (no branch push/pull), so it can run as the web user: sudo -u www-data ./deploy


timestamp() {
date +"%F_%H.%M.%S"
}
backup="$(timestamp)"

c() {
if [ $2 ]; then
	echo -e "\e[$1;$2m"
else
	echo -e "\e[$1m"
fi
}
ce() {
echo -e "\e[m"
}

if [ ! -d ".git" ] || [ ! -d "../production" ]; then
	echo "Please run from the dev checkout (next to ../production)"
	exit 1
fi

# Use nvm if it's installed (per-user ~/.nvm, or $NVM_DIR), honouring .nvmrc; otherwise use node from PATH
NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
	export NVM_DIR
	. "$NVM_DIR/nvm.sh"
	nvm install >/dev/null || exit 1
	nvm use >/dev/null || exit 1
fi
for tool in node yarn; do
	if ! command -v $tool >/dev/null; then
		echo "$(c 1 31)$tool not found.$(ce) Install nvm for this user, then: nvm install && npm install -g yarn@1"
		exit 1
	fi
done
echo "$(c 32)Using node $(node -v), yarn $(yarn -v)$(ce)"

echo "$(c 32)Deploying this checkout:$(ce)"
echo
git log -n 1 | cat -
echo
dirty="$(git status --porcelain --untracked-files=no)"
if [ -n "$dirty" ]; then
	echo "$(c 1 33)Uncommitted changes that will be deployed too:$(ce)"
	echo "$dirty"
	echo
fi

echo "$(c 32)Current production:$(ce)"
echo
cat ../production/DEPLOYED_VERSION 2>/dev/null || echo "(no DEPLOYED_VERSION file)"

echo
read -p "$(c 32)  Are you sure you want to deploy this? Press $(c 1 33)y/n $(ce)" -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
echo "$(c 1 31)Aborted$(ce)"
exit;
fi

(
	cd .. || exit 1
	mkdir -p prod_backups || exit 1
	cp -a production prod_backups/$backup || exit 1
	echo "$(c 33)Backed up locally to$(ce) prod_backups/$backup"
	ln -sfn prod_backups/$backup prod
) || (
	echo "$(c 1 31)  Failed to backup$(ce)"
	exit 1
) || exit

(
	echo "$(c 33)Updating Dependencies$(ce)"
	yarn install || exit 1
	echo "$(c 33)Building$(ce)"
	node_modules/.bin/gulp build:release || exit 1
	echo "$(c 33)Done! Let's launch it.$(ce)"
	rm -rf ../production || exit 1
	echo "$(c 33)Copying$(ce)"
	mkdir ../production || exit 1
	# everything except git metadata, so production isn't a linked checkout
	tar -c --exclude=./.git . | tar -x -C ../production || exit 1
	echo "$(c 33)Restoring production configuration$(ce)"
	cp ../prod_backups/$backup/config.dev.ini ../production/ || exit 1
	{
		echo "commit: $(git rev-parse HEAD) ($(git rev-parse --abbrev-ref HEAD))"
		echo "subject: $(git log -n 1 --format=%s)"
		echo "deployed: $(date -R) by $(whoami)"
		[ -n "$dirty" ] && echo "uncommitted changes included:" && echo "$dirty"
	} > ../production/DEPLOYED_VERSION
	cd ../
	echo "$(c 33)Restoring Symlink to new production$(ce)"
	ln -sfn production prod || exit 1
) || (
	echo "$(c 1 31)   Building failed! Leaving symlink at$(ce) prod_backups/$backup"
	exit 1
) || exit 1
echo "$(c 32)==== Production rollout complete ====$(ce)"
#rebuild dev
node_modules/.bin/gulp build || echo "Dev rebuild failed"
